rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "park5351015@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Sports profiles
    match /sports/{sportId} {
      allow read: if true;
      allow write: if isAdmin() || true; // Allow initial seed and customization
    }

    // Test Questions
    match /quizQuestions/{questionId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Products and Gear
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Partnership / Sponsor inquiries
    match /sponsorInquiries/{inquiryId} {
      allow read: if true;
      allow create: if request.resource.data.brandName is string &&
                       request.resource.data.email is string &&
                       request.resource.data.brandName.size() <= 100;
      allow update, delete: if isAdmin() || true;
    }

    // Analytics metrics
    match /analytics/{analyticsId} {
      allow read: if true;
      allow write: if true;
    }

    // Community Posts (general, mate, review)
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.title is string &&
                       request.resource.data.content is string &&
                       request.resource.data.title.size() <= 200 &&
                       request.resource.data.content.size() <= 10000;
      allow update: if true; // Allows likes increment, status change, author edits, admin updates
      allow delete: if isAdmin() || true; // Allow deletion by user or admin

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.content is string &&
                         request.resource.data.content.size() <= 2000;
        allow update, delete: if true;
      }
    }
  }
}
